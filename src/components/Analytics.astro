---
/**
 * Tracking — nada carrega enquanto nao houver ID.
 *
 * Com PUBLIC_GTM_ID, PUBLIC_META_PIXEL_ID e PUBLIC_GA4_ID vazios (o
 * estado atual), este componente injeta ZERO script de terceiro. Cada
 * bloco abaixo so aparece no HTML se a variavel correspondente estiver
 * preenchida no .env.
 *
 * Ver README, secao "Ativar GTM, Pixel e GA4".
 */
const GTM = import.meta.env.PUBLIC_GTM_ID?.trim();
const PIXEL = import.meta.env.PUBLIC_META_PIXEL_ID?.trim();
const GA4 = import.meta.env.PUBLIC_GA4_ID?.trim();
---

{
  /* dataLayer sempre existe: os CTAs empurram evento nele com `?.`, e
     ter o array declarado deixa o push funcionar mesmo antes do GTM
     terminar de carregar. Sao 40 bytes, nao um script de terceiro. */
}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
</script>

{
  GTM && (
    <script is:inline define:vars={{ GTM }}>
      {`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM}');`}
    </script>
  )
}

{
  GA4 && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA4}`}
      />
      <script is:inline define:vars={{ GA4 }}>
        {`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA4}');`}
      </script>
    </>
  )
}

{
  PIXEL && (
    <script is:inline define:vars={{ PIXEL }}>
      {`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${PIXEL}');fbq('track','PageView');`}
    </script>
  )
}
