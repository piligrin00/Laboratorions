---
import { NAV, NEGOCIO, waLink } from '../data/site';
import WhatsappIcon from './WhatsappIcon.astro';
import { Icon } from 'astro-icon/components';

/**
 * Rodape.
 *
 * SEM CNPJ, SEM razao social, SEM endereco completo — a operacao e por
 * RPA e o endereco nao e publico. Ver PRODUCT.md, "Evidence on Hand".
 * O ano e calculado para nao envelhecer sozinho.
 */
const ano = new Date().getFullYear();

const telefoneHref = `tel:${NEGOCIO.whatsappE164}`;
---

<footer class="band-dark">
  <div class="band-inner py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1.2fr]">
      <div>
        <div class="flex items-center gap-3">
          <img
            src="/logo.png"
            alt=""
            width="123"
            height="119"
            class="h-10 w-auto"
            loading="lazy"
          />
          <span class="font-sans text-body-sm font-semibold tracking-tight text-ink">
            Laboratório <span class="text-accent">NS</span>
          </span>
        </div>
        <p class="mt-4 max-w-xs text-caption text-ink-muted">
          Laboratório de prótese odontológica · Rio de Janeiro
        </p>
        <p class="readout mt-6">{NEGOCIO.localizacao}</p>
      </div>

      <nav aria-label="Navegação do rodapé">
        <h2 class="readout">Navegar</h2>
        <ul class="mt-3">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex min-h-11 items-center text-body-sm text-ink-muted transition-colors duration-200 hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="readout">Contato</h2>
        <ul class="mt-3">
          <li>
            <a
              href={waLink('ctaFinal')}
              target="_blank"
              rel="noopener"
              data-wa="ctaFinal"
              class="inline-flex min-h-11 items-center gap-2.5 text-body-sm font-semibold text-accent transition-colors duration-200 hover:text-accent-hover"
            >
              <WhatsappIcon class="size-4 shrink-0" />
              WhatsApp {NEGOCIO.whatsapp}
            </a>
          </li>
          <li>
            <a
              href={telefoneHref}
              class="inline-flex min-h-11 items-center gap-2.5 text-body-sm text-ink-muted transition-colors duration-200 hover:text-ink"
            >
              <Icon name="lucide:phone" class="size-4 shrink-0" />
              Ligar para {NEGOCIO.whatsapp}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${NEGOCIO.email}`}
              class="inline-flex min-h-11 items-center gap-2.5 break-all text-body-sm text-ink-muted transition-colors duration-200 hover:text-ink"
            >
              <Icon name="lucide:mail" class="size-4 shrink-0" />
              {NEGOCIO.email}
            </a>
          </li>
          <li>
            <a
              href={NEGOCIO.instagram}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2.5 text-body-sm text-ink-muted transition-colors duration-200 hover:text-ink"
            >
              <Icon name="lucide:instagram" class="size-4 shrink-0" />
              {NEGOCIO.instagramHandle}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="rule mt-14 pt-6 text-caption text-ink-muted">
      © {ano} {NEGOCIO.nome}. Todos os direitos reservados.
    </p>
  </div>
</footer>
