---
import { HERO } from '../../data/site';
import CtaButton from '../CtaButton.astro';

/**
 * Primeira dobra: só o texto.
 *
 * CENTRALIZADA, e é a única seção da página que é. O manifesto de
 * fechamento é a outra. Os dois são os extremos da página e centralizar
 * ali é acento deliberado; centralizar o resto é o tique número um de
 * site gerado.
 *
 * SEM imagem. A colagem de duas fotos que existia aqui foi removida a
 * pedido do cliente. A prova visual da página vive na galeria de casos e
 * na seção de tecnologia, que é onde o dentista vai procurá-la.
 *
 * A foto do escaneamento continua em src/assets/hero/ e o texto
 * alternativo dela em `HERO.fotoAlt`, os dois sem uso no momento. Se a
 * colagem voltar, é só reintroduzir o bloco; nada foi apagado.
 *
 * SEM glow radial atrás do conteúdo. Glow atrás do herói é a marca
 * d'água da landing page gerada, e foi revogado pela revisão de direção.
 *
 * NADA aqui tem data-reveal. A primeira dobra não anima: ela está lá na
 * primeira pintura. Animar a entrada do H1 significa que o conteúdo mais
 * importante começa invisível e depende do observer para aparecer.
 */
---

<div class="mx-auto max-w-[760px] text-center">
  <h1 class="text-display text-ink">{HERO.h1}</h1>

  <p class="measure mx-auto mt-7 text-body-sm text-ink-muted">
    {HERO.subtitulo}
  </p>

  <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
    <CtaButton context="hero" variant="solida" />
    <CtaButton
      context="hero"
      variant="fantasma"
      href="#casos"
      label="Ver os casos"
      icone={false}
    />
  </div>

  {/* O terceiro badge ("Vamos até o seu consultório") é o mais
      importante da página: é o que remove a objeção de quem ainda não
      escaneia. Sem data-reveal, como o resto do herói. */}
  <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
    {HERO.badges.map((badge) => <li class="chip">{badge}</li>)}
  </ul>
</div>
