---
import { avaliacoes } from '../../data/depoimentos';
import { MOSTRAR_DEPOIMENTOS } from '../../data/site';

/**
 * Avaliações do Google.
 *
 * FAIXA HORIZONTAL NO CELULAR, grade no desktop.
 *
 * Eu tinha argumentado contra carrossel aqui, e mudei de posição quando
 * a restrição mudou: o cliente pediu a seção inteira numa tela só.
 * Empilhadas, as três avaliações davam 985px de altura contra 844 de
 * viewport — não cabia. Em faixa, cabe com folga.
 *
 * O argumento antigo continua valendo contra carrossel DE BIBLIOTECA,
 * que monta e desmonta slide e esconde texto do Google. Não vale contra
 * scroll-snap de CSS: as três avaliações seguem inteiras no HTML, todas
 * indexáveis, e a rolagem é do navegador. É a mesma técnica que a
 * galeria usava, e pela mesma razão.
 *
 * SEM CABEÇALHO PRÓPRIO. Este bloco é a continuação da seção de casos:
 * o título dela já anuncia as cinco estrelas, e um segundo `<h2>`
 * ("O que os dentistas dizem") repetiria o assunto e quebraria a
 * hierarquia da página em duas.
 *
 * As três avaliações são reais e verbatim. O rótulo de origem é
 * "Google", nunca um CRO: avaliação do Google não traz CRO e inventar
 * um seria falsificar credencial. Ver src/data/depoimentos.ts.
 */
---

{
  MOSTRAR_DEPOIMENTOS && avaliacoes.length > 0 && (
    <div class="mt-6">
      <div
        class="avaliacoes-faixa -mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 sm:mx-0 sm:px-0 lg:grid lg:grid-cols-3 lg:gap-px lg:overflow-visible lg:bg-hairline lg:pb-0"
        role="region"
        aria-label="Avaliações no Google"
        tabindex="0"
      >
        {avaliacoes.map((avaliacao, i) => (
        <figure
          class="flex w-[85vw] shrink-0 snap-start flex-col rounded-[14px] bg-surface-raised p-7 sm:w-[60vw] lg:w-auto lg:rounded-none"
          data-reveal
          style={`--reveal-delay: ${i * 80}ms`}
        >
          <blockquote class="flex-1 text-body-sm text-ink">
            {avaliacao.texto}
          </blockquote>

          <figcaption class="mt-7 flex items-center gap-3.5">
            <span
              aria-hidden="true"
              class="grid size-11 shrink-0 place-items-center rounded-full border border-hairline text-caption text-ink-muted"
            >
              {avaliacao.iniciais}
            </span>

            <span>
              <span class="block text-caption font-medium text-ink">
                {avaliacao.nome}
              </span>
              <span class="readout">Avaliação no Google</span>
            </span>
          </figcaption>
        </figure>
        ))}
      </div>
    </div>
  )
}

<style>
  /* Mesma regra da galeria: a barra de rolagem some no celular. O card
     parcial na borda ja diz que tem mais, e uma barra atravessada
     embaixo dos cards rouba atencao do texto. */
  .avaliacoes-faixa {
    scrollbar-width: none;
  }

  .avaliacoes-faixa::-webkit-scrollbar {
    display: none;
  }

  /* A faixa e focavel por tabindex: sem isto quem navega por teclado
     nao saberia onde esta. */
  .avaliacoes-faixa:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
