# =====================================================================
# Laboratorio NS — variaveis de ambiente
# ---------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha SOMENTE o que voce ja tem.
# Com as tres variaveis vazias, NENHUM script de terceiro e carregado
# no site (nem GTM, nem Pixel, nem GA4). Ver README, secao "Tracking".
# =====================================================================

# Google Tag Manager — ex.: GTM-XXXXXXX
PUBLIC_GTM_ID=

# Meta (Facebook/Instagram) Pixel — ex.: 123456789012345
PUBLIC_META_PIXEL_ID=

# Google Analytics 4 — ex.: G-XXXXXXXXXX
PUBLIC_GA4_ID=
